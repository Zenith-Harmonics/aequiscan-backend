# =============================================================================
# AequiScan Environment & API Configuration
# =============================================================================

# App Environment ("development" | "production")
AEQUISCAN_ENV=development
DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# NASA Earthdata Login (Required for live EMIT, MODIS, SMAP downloads)
# Create a free account at: https://urs.earthdata.nasa.gov
# -----------------------------------------------------------------------------
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# -----------------------------------------------------------------------------
# OpenTopography Global DEM API (SRTM GL1, COP30, NASADEM)
# Free registration and API key at: https://opentopography.org
# -----------------------------------------------------------------------------
OPENTOPOGRAPHY_API_KEY=

# -----------------------------------------------------------------------------
# Microsoft Planetary Computer (Optional; increases STAC rate limits)
# Free key at: https://planetarycomputer.microsoft.com
# -----------------------------------------------------------------------------
PLANETARY_COMPUTER_API_KEY=

# -----------------------------------------------------------------------------
# Public REST Data Endpoints (Preconfigured - no API keys required)
# -----------------------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
ASF_DAAC_BASE_URL=https://api.daac.asf.alaska.edu/services/search/param
PDS_ODE_BASE_URL=https://oderest.rsl.wustl.edu/live2/
